{
  "name": "kanto-pokedex",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "Interactive recreation of the classic Kanto-era red Pokédex device.",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview --port 4319 --strictPort",
    "typecheck": "tsc -b",
    "test": "vitest run",
    "test:watch": "vitest",
    "smoke": "node scripts/browser-smoke.mjs"
  },
  "dependencies": {
    "react": "^19.1.0",
    "react-dom": "^19.1.0"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.3.0",
    "@testing-library/user-event": "^14.6.1",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^5.0.0",
    "jsdom": "^26.1.0",
    "playwright-core": "^1.55.0",
    "typescript": "^5.9.2",
    "vite": "^7.1.0",
    "vitest": "^3.2.4"
  }
}
