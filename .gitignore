# Publish only the README, comparison images, and runnable projects.
/*
!/.gitignore
!/README.md
!/assets/
/assets/*
!/assets/reference.png
!/assets/astra-desktop.png
!/assets/astra-mobile.png
!/assets/astra-deepseek-desktop.png
!/assets/astra-deepseek-mobile.png
!/assets/deepseek-desktop.png
!/assets/deepseek-mobile.png
!/pokedex-astra/
/pokedex-astra/*
!/pokedex-astra/src/
!/pokedex-astra/public/
!/pokedex-astra/tests/
!/pokedex-astra/scripts/
!/pokedex-astra/index.html
!/pokedex-astra/package.json
!/pokedex-astra/package-lock.json
!/pokedex-astra/tsconfig*.json
!/pokedex-astra/vite.config.ts
!/pokedex-astra/playwright.config.ts
!/pokedex-astra/.oxlintrc.json
!/pokedex-deepseek-v4.1-astra/
/pokedex-deepseek-v4.1-astra/*
!/pokedex-deepseek-v4.1-astra/src/
!/pokedex-deepseek-v4.1-astra/public/
!/pokedex-deepseek-v4.1-astra/tests/
!/pokedex-deepseek-v4.1-astra/scripts/
!/pokedex-deepseek-v4.1-astra/index.html
!/pokedex-deepseek-v4.1-astra/package.json
!/pokedex-deepseek-v4.1-astra/package-lock.json
!/pokedex-deepseek-v4.1-astra/tsconfig*.json
!/pokedex-deepseek-v4.1-astra/vite.config.ts
!/pokedex-deepseek-v4.1-astra/playwright.config.ts
!/pokedex-deepseek-v4.1-astra/.oxlintrc.json
!/pokedex-deepseek-v4.1-harness/
/pokedex-deepseek-v4.1-harness/*
!/pokedex-deepseek-v4.1-harness/src/
!/pokedex-deepseek-v4.1-harness/public/
!/pokedex-deepseek-v4.1-harness/tests/
!/pokedex-deepseek-v4.1-harness/scripts/
!/pokedex-deepseek-v4.1-harness/index.html
!/pokedex-deepseek-v4.1-harness/package.json
!/pokedex-deepseek-v4.1-harness/package-lock.json
!/pokedex-deepseek-v4.1-harness/tsconfig*.json
!/pokedex-deepseek-v4.1-harness/vite.config.ts
!/pokedex-deepseek-v4.1-harness/playwright.config.ts
!/pokedex-deepseek-v4.1-harness/.oxlintrc.json

# Generated files and private material remain local at every depth.
**/node_modules/
**/dist/
**/build/
**/coverage/
**/artifacts/
**/test-results/
**/playwright-report/
**/.benchmark/
**/benchmark-review/
**/.git/
**/.DS_Store
**/*.tsbuildinfo
**/*.log
**/*.jsonl
**/*.tmp
**/*.bak
**/.env
**/.env.*
**/*.pem
**/*.key
**/*.p12
**/*.pfx
**/*credentials*
**/*secret*
**/.npmrc
**/.netrc
**/.aws/
**/.ssh/
**/.vercel/
**/.cursor/
**/.codex/

!/assets/workflow.jpg
